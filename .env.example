# Work With Us contact form
# Copy to a local .env for scripts/dev-contact-server.js. Never commit real keys.

CONTACT_EMAIL_TO=feedback@burlingtonnews.ca
CONTACT_EMAIL_FROM=Burlington News <noreply@burlingtonnews.ca>
RESEND_API_KEY=

# Local preview only. Production must leave this unset.
CONTACT_DRY_RUN=1

# Optional. Server-side only. Used by scripts/discover_video_leads.py.
# Never expose this in client JavaScript or committed JSON.
YOUTUBE_API_KEY=

# Optional. Official Google Programmable Search only. Leave unset to skip.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
