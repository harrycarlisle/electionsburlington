  "gates": ["evidence", "burlington", "imageRights", "duplicate"],
  "autoPublish": {
    "allowedVerificationTiers": ["primary", "official", "reported", "corroborated"],
    "blockedTopics": [
      "unverified allegation",
      "candidate endorsement",
      "election persuasion",
      "crime speculation",
      "medical diagnosis",
      "private-person accusation"
    ],
    "blockedTerms": ["alleged", "accused", "charged", "endorse", "vote for", "fraud", "corrupt", "sexual", "murder"],
    "requireSourceUrl": true,
    "requireStoryGoal": true,
    "requireImageRights": false,
    "holdIfUnclear": true
  },
  "discovery": {
    "avoidSinglePublisherDependence": true,
    "aggregationPenalty": 0.76,
    "burlingtonTodayPenalty": 0.82,
    "preferredSourceMix": [
      "primary official records",
      "Halton/Burlington public agencies",
      "Metrolinx and Ontario 511",
      "community organizations and sports leagues",
      "Reddit/Facebook public posts as leads",
      "regional/local reporting as corroboration or background",
      "older archives for historical context"
    ]
  },
  "rotation": {
    "leadCooldownDays": 2,
    "yesterdayPenalty": 1.4,
    "recoverPerDay": 1.0
  },
  "originalStory": {
    "cadence": "At least one original-story candidate every daily news watch. Publish nothing when reporting is not strong enough.",
    "minimumCandidates": 1,
    "excludeStatuses": ["published", "hold-duplicate"]
  },
  "eligibility": {
    "rightNow": {
      "minFreshness": 3.2,
      "minRelevance": 3.4,
      "minSourceConfidence": 3.8,
      "minConsequence": 3.0
    },
    "homepage": {
      "minRelevance": 3.4,
      "minSourceConfidence": 3.8,
      "minRadarScore": 58
    }
  },
  "writing": {
    "singleGoal": true,
    "title": "clear + curiosity-driven",
    "deck": "create curiosity rather than give away the full answer",
    "structure": ["title promise", "deck curiosity", "action", "consequence", "next implication", "what happens next"],
    "answerReaderQuestions": ["where", "why", "how", "what changed", "why it matters", "what happens next"],
    "ifSourceDoesNotDisclose": "Say that clearly instead of writing around the hole.",
    "avoid": ["listicle framing unless the subject requires a list", "filler intros", "generic everything-you-need-to-know language", "unsupported claims", "fake quotes", "auto-publishing weak or unclear stories for volume"]
  }
